[flake8]
max-line-length = 100
exclude = .git,__pycache__,build,dist,venv,.venv,env,.env
extend-ignore = E203,W503,E231
per-file-ignores =
    # Tests: star imports from conftest helpers; docstrings not required
    tests/*: F401, F403, F405, D
    # Allow __init__.py to import but not use
    */__init__.py: F401
